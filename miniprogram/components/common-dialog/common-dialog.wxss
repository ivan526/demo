.mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(15, 23, 42, 0.44);
}

.dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.content {
  margin-top: 18rpx;
  color: #475569;
  line-height: 44rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.cancel,
.confirm {
  flex: 1;
  height: 76rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.cancel {
  background: #f8fafc;
  color: #334155;
}

.confirm {
  background: #2563eb;
  color: #ffffff;
}
