.tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  padding: 6rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
}

.tab {
  height: 72rpx;
  border-radius: 8rpx;
  color: #475569;
  line-height: 72rpx;
  text-align: center;
}

.tab.active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 700;
}

.course-list {
  display: grid;
  gap: 18rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.import-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.import-btn.ai-btn {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
}

.import-btn::after {
  border: none;
}

.import-btn .icon {
  font-size: 36rpx;
  font-weight: 700;
}

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
}
