.practice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.course-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.combo {
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  color: #166534;
  font-weight: 700;
}

.sentence-panel {
  display: grid;
  gap: 18rpx;
}

.chinese {
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.phonetic {
  padding: 18rpx 24rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #1d4ed8;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.result {
  display: grid;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.result-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 8rpx;
}

.all-correct-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  margin-top: 8rpx;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.success-text {
  color: #166534;
  font-size: 30rpx;
  font-weight: 700;
}

.wrong-questions-section {
  margin-top: 8rpx;
}

.wrong-question-item {
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fef2f2;
  margin-bottom: 12rpx;
  border-left: 6rpx solid #dc2626;
}

.wrong-question-chinese {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.wrong-question-phonetic {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.wrong-question-answer {
  margin-bottom: 8rpx;
}

.answer-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.answer-user {
  font-size: 26rpx;
  color: #dc2626;
  word-break: break-all;
  line-height: 38rpx;
}

.answer-correct {
  font-size: 26rpx;
  color: #16a34a;
  word-break: break-all;
  line-height: 38rpx;
}

.wrong-review-button {
  height: 88rpx;
  border-radius: 8rpx;
  background: #f97316;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-button {
  height: 80rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #334155;
  font-size: 28rpx;
  line-height: 80rpx;
}
