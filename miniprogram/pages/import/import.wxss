.container {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  border: none;
}

.btn-outline {
  background-color: #fff;
  color: #2563eb;
  border: 2rpx solid #e2e8f0;
}

.btn-primary {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #fff;
}

.import-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.input-container {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.json-input {
  width: 100%;
  min-height: 400rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  font-family: monospace;
}

.error-message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background-color: #fef2f2;
  border-radius: 12rpx;
  border-left: 6rpx solid #ef4444;
}

.error-text {
  font-size: 26rpx;
  color: #dc2626;
  line-height: 1.5;
}

.tips {
  margin-top: 40rpx;
  padding: 24rpx;
  background-color: #eff6ff;
  border-radius: 12rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e40af;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #3b82f6;
  line-height: 1.8;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.template-text {
  font-size: 24rpx;
  font-family: monospace;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f1f5f9;
}

.success-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.8);
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2000;
}

.success-icon {
  font-size: 64rpx;
  color: #22c55e;
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 32rpx;
  color: #fff;
}
