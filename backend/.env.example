# Environment Configuration
# Copy this file to .env and fill in your actual values.
# JWT_SECRET_KEY MUST be a random string of at least 32 characters (server refuses to start otherwise).

# Debug mode (set to true only for development — auto-reload + verbose errors)
DEBUG=false

# Mock login mode (skip WeChat API for local dev; stable account per `code` value, e.g. code="dev-user-1")
MOCK_LOGIN=false

# JWT Configuration (generate a strong random key, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=replace_me_with_a_random_string_at_least_32_characters_long

# WeChat Mini Program Configuration
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# Doubao (Volcengine Ark) API key for AI course generation
DOUBAO_API_KEY=your_doubao_api_key
