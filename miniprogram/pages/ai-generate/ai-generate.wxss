.container {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.topic-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background-color: #f8fafc;
}

.topic-input:focus {
  border-color: #2563eb;
  background-color: #fff;
}

.difficulty-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.option {
  padding: 24rpx 16rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  text-align: center;
  background-color: #f8fafc;
}

.option.active {
  border-color: #2563eb;
  background-color: #eff6ff;
}

.option-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.option.active .option-label {
  color: #2563eb;
}

.option-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

.count-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.count-option {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background-color: #f8fafc;
}

.count-option.active {
  border-color: #2563eb;
  background-color: #eff6ff;
  color: #2563eb;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-radius: 16rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
}

.generate-btn::after {
  border: none;
}

.generate-btn[disabled] {
  opacity: 0.7;
}

.tips {
  margin-top: 40rpx;
  padding: 24rpx;
  background-color: #fef3c7;
  border-radius: 12rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #b45309;
  line-height: 1.8;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 92%;
  max-width: 700rpx;
  max-height: 85vh;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.course-preview-info {
  padding: 24rpx 32rpx 16rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
}

.preview-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e40af;
  margin-bottom: 8rpx;
}

.preview-desc {
  font-size: 26rpx;
  color: #3b82f6;
}

.preview-scroll {
  flex: 1;
  max-height: 50vh;
}

.sentence-list {
  padding: 16rpx 32rpx 32rpx;
}

.sentence-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.sentence-item:last-child {
  border-bottom: none;
}

.sentence-number {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #eff6ff;
  color: #2563eb;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.sentence-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sentence-en {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
  line-height: 1.4;
}

.sentence-ph {
  font-size: 22rpx;
  color: #64748b;
  font-family: monospace;
}

.sentence-cn {
  font-size: 24rpx;
  color: #94a3b8;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f1f5f9;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  border: none;
}

.btn-outline {
  background-color: #fff;
  color: #2563eb;
  border: 2rpx solid #e2e8f0;
}

.btn-primary {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #fff;
}
