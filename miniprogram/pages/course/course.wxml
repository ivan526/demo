<view class="page">
  <view class="tabs section">
    <view class="tab {{activeTab === 'builtin' ? 'active' : ''}}" data-tab="builtin" bindtap="switchTab">内置课程</view>
    <view class="tab {{activeTab === 'custom' ? 'active' : ''}}" data-tab="custom" bindtap="switchTab">我的课程</view>
  </view>

  <view class="course-list" wx:if="{{activeTab === 'builtin'}}">
    <course-card
      wx:for="{{builtinCourses}}"
      wx:key="course_id"
      course="{{item}}"
      bind:select="onCourseSelect"
    />
  </view>

  <view wx:if="{{activeTab === 'custom'}}">
    <view class="action-bar">
      <button class="import-btn ai-btn" bindtap="goToAIGenerate">
        <text class="icon">✨</text>
        <text class="text">AI生成</text>
      </button>
      <button class="import-btn" bindtap="goToImport">
        <text class="icon">+</text>
        <text class="text">导入课程</text>
      </button>
    </view>
    <view class="empty-state" wx:if="{{!customCourses.length}}">
      <text class="empty-icon">📚</text>
      <text class="empty-title">还没有自定义课程</text>
      <text class="empty-desc">点击上方按钮导入JSON课程</text>
    </view>
    <view class="course-list" wx:else>
      <course-card
        wx:for="{{customCourses}}"
        wx:key="course_id"
        course="{{item}}"
        bind:select="onCourseSelect"
      />
    </view>
  </view>
</view>
