page {
  min-height: 100%;
  background: #f6f7fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.primary-button {
  height: 88rpx;
  border-radius: 8rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-button {
  height: 80rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #334155;
  font-size: 28rpx;
  line-height: 80rpx;
}

.empty-state {
  padding: 40rpx 24rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #64748b;
  text-align: center;
}
